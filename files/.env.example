# ProAnalyst RAG Bot Configuration Template
# ──────────────────────────────────────────────────────────────────────────────
# SECURITY NOTE: This file shows where the API key goes.
# DO NOT commit the actual .env file to version control.
# Copy this to .env and fill in your actual values.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED: Your DeepInfra API key
# Obtain from: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# OPTIONAL: Override the default ChromaDB storage directory
# CHROMA_DIR=./chroma_db
